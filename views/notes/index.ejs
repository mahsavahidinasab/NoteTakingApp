<%- include('../partials/header') %>

<div class="page-header">
    <h1>My Notes</h1>
    <a href="/notes/new" class="btn btn-primary">+ New Note</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <p class="alert alert-error"><%= error %></p>
<% } %>

<% if (notes.length === 0) { %>
    <p class="empty-state">You don't have any notes yet. Create your first one!</p>
<% } else { %>
    <ul class="note-list">
        <% notes.forEach(function(note) { %>
            <li class="note-row">
                <a class="note-title" href="/notes/<%= note._id %>"><%= note.title %></a>
                <div class="note-actions">
                    <a href="/notes/<%= note._id %>/edit" class="btn btn-small">Edit</a>
                    <form action="/notes/<%= note._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Delete this note?');">
                        <button type="submit" class="btn btn-small btn-danger">Delete</button>
                    </form>
                </div>
            </li>
        <% }); %>
    </ul>
<% } %>

<%- include('../partials/footer') %>
